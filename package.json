{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "pages:build": "npm run build && node scripts/stage-pages.mjs",
    "pages:check": "node scripts/stage-pages.mjs --check",
    "check": "npm run typecheck && npm test && npm run build && npm run pages:check",
    "health": "node --env-file-if-exists=.env.local --import tsx src/server/health-cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
